void setup()
{
     Serial.begin(115200);
    delay(2000);

    WiFi.mode(WIFI_STA);

    Serial.println();
    Serial.println("=== gen4-ESP32-43CT ===");

    Serial.print("WiFi MAC Address: ");
    Serial.println(WiFi.macAddress());
} // end Setup **do not alter, remove or duplicate this line**

